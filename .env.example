# Stripe test mode (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: a Price from Stripe Dashboard → Products.
# If this is empty, the site charges STRIPE_DEPOSIT_AMOUNT_CENTS instead.
STRIPE_PRICE_ID=

# Deposit amount in cents. Default is $300.
STRIPE_DEPOSIT_AMOUNT_CENTS=30000
NEXT_PUBLIC_DEPOSIT_AMOUNT_CENTS=30000

# Public site URL used for Stripe success/cancel redirects.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the contact section. Change these before you share the site.
NEXT_PUBLIC_CONTACT_EMAIL=scott@midmichiganwebsites.com
NEXT_PUBLIC_CONTACT_PHONE=
